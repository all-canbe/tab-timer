# Widget Preview related
.widget_preview/

# ---------------------------------------------------------------------------
# 本地开发布局（本段需与 setbeat_flutter/.gitignore 完全一致）
# ---------------------------------------------------------------------------
# 仓库根目录是发布副本，setbeat_flutter/ 是本地工作副本：开发在子目录内进行，
# 改动用 sync-from-dev.ps1 同步到根目录后提交。
setbeat_flutter/
sync-from-dev.ps1

# Android 构建产物（AGP 输出在模块目录下，根部的 /build/ 覆盖不到）
/android/app/build/
